#!/bin/bash
# Removes outputs and execution counts from all Jupyter notebooks staged for commit and stages
# the cleaned files again.

set -o pipefail

git diff --cached --name-only -z --diff-filter=ACM -- '*.ipynb' |
while IFS= read -r -d '' file; do
	nbstripout "$file" || exit 1
	git add "$file" || exit 1
done
